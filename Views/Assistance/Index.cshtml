@{
    ViewData["Title"] = "Assistance";

    // Do not use the MVC shared layout for this page.
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Assistance - Student Help Hub</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Inter font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
            body {
                font-family: 'Inter', sans-serif;
            }
    </style>
</head>

<body class="bg-gray-50 text-gray-900">

    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 h-screen w-64 bg-gray-100 border-r border-gray-200">

        <!-- Logo -->
        <div class="px-6 py-6 border-b border-gray-200">
            <h1 class="text-xl font-bold text-blue-700">
                Student Help Hub
            </h1>

            <p class="text-sm text-gray-500 mt-1">
                Student Services
            </p>
        </div>

        <!-- Navigation -->
        <nav class="p-4 space-y-2">

            <!-- Dashboard -->
            <a href="/Student/Dashboard"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                <span class="w-6 text-center">🏠</span>
                <span>Dashboard</span>

            </a>

            <!-- Timetable -->
            <a href="/Timetable/Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                <span class="w-6 text-center">📅</span>
                <span>Timetable</span>

            </a>

            <!-- Lost & Found -->
            <a href="/LostFound/Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                <span class="w-6 text-center">🔍</span>
                <span>Lost & Found</span>

            </a>

            <!-- Assistance -->
            <a href="/Assistance/Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg bg-blue-700 text-white">

                <span class="w-6 text-center">🤝</span>
                <span>Assistance</span>

            </a>

            <!-- Announcements -->
            <a href="/Announcement/Index"
               class="flex items-center justify-between px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                <div class="flex items-center gap-3">
                    <span class="w-6 text-center">📢</span>
                    <span>Announcements</span>
                </div>

                <span class="bg-red-500 text-white text-xs px-2 py-1 rounded-full">
                    3
                </span>

            </a>

            <!-- Events -->
            <a href="#"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                <span class="w-6 text-center">🎉</span>
                <span>Events</span>

            </a>

            <!-- Campus Map -->
            <a href="#"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                <span class="w-6 text-center">🗺️</span>
                <span>Campus Map</span>

            </a>

            <!-- My Profile -->
            <a href="#"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                <span class="w-6 text-center">👤</span>
                <span>My Profile</span>

            </a>

        </nav>

        <!-- Bottom Navigation -->
        <div class="absolute bottom-0 left-0 right-0 p-4 border-t border-gray-200">

            <!-- Settings -->
            <a href="#"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                <span class="w-6 text-center">⚙️</span>
                <span>Settings</span>

            </a>

            <!-- Logout -->
            <a href="#"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-red-600 transition-all">

                <span class="w-6 text-center">🚪</span>
                <span>Logout</span>

            </a>

        </div>

    </aside>


    <!-- Main Content -->
    <main class="ml-64 min-h-screen">

        <!-- Top Bar -->
        <header class="bg-white border-b border-gray-200 px-8 py-5 flex items-center justify-between">

            <div>
                <h2 class="text-xl font-bold text-gray-900">
                    Welcome back, Student 👋
                </h2>

                <p class="text-sm text-gray-500">
                    Find the support you need.
                </p>
            </div>

            <div class="flex items-center gap-4">

                <button class="relative text-gray-500 text-xl">
                    🔔

                    <span class="absolute -top-1 -right-1 w-2 h-2 bg-red-500 rounded-full"></span>
                </button>

                <div class="w-10 h-10 rounded-full bg-blue-700 text-white flex items-center justify-center font-bold">
                    S
                </div>

            </div>

        </header>


        <!-- Page Content -->
        <section class="p-8">

            <!-- Page Heading -->
            <div class="mb-8">

                <h1 class="text-3xl font-bold text-gray-900">
                    Student Assistance
                </h1>

                <p class="text-gray-500 mt-2">
                    Access academic, financial and student support services.
                </p>

            </div>


            <!-- Assistance Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

                <!-- Academic Support -->
                <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all">

                    <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center text-2xl mb-5">
                        📚
                    </div>

                    <h2 class="text-lg font-bold mb-2">
                        Academic Support
                    </h2>

                    <p class="text-sm text-gray-500 mb-6">
                        Get help with your subjects, assignments and academic challenges.
                    </p>

                    <button class="w-full bg-blue-700 hover:bg-blue-800 text-white font-medium py-3 rounded-lg transition-all">
                        Get Academic Help
                    </button>

                </div>


                <!-- Financial Assistance -->
                <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all">

                    <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center text-2xl mb-5">
                        💰
                    </div>

                    <h2 class="text-lg font-bold mb-2">
                        Financial Assistance
                    </h2>

                    <p class="text-sm text-gray-500 mb-6">
                        Find information about financial aid, funding and student support.
                    </p>

                    <button class="w-full bg-green-600 hover:bg-green-700 text-white font-medium py-3 rounded-lg transition-all">
                        View Financial Support
                    </button>

                </div>


                <!-- Student Wellness -->
                <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all">

                    <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center text-2xl mb-5">
                        ❤️
                    </div>

                    <h2 class="text-lg font-bold mb-2">
                        Student Wellness
                    </h2>

                    <p class="text-sm text-gray-500 mb-6">
                        Access wellness, counselling and general student support services.
                    </p>

                    <button class="w-full bg-purple-600 hover:bg-purple-700 text-white font-medium py-3 rounded-lg transition-all">
                        View Wellness Services
                    </button>

                </div>


                <!-- Career Support -->
                <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all">

                    <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center text-2xl mb-5">
                        💼
                    </div>

                    <h2 class="text-lg font-bold mb-2">
                        Career Support
                    </h2>

                    <p class="text-sm text-gray-500 mb-6">
                        Get access to career guidance, internships and employment resources.
                    </p>

                    <button class="w-full bg-orange-500 hover:bg-orange-600 text-white font-medium py-3 rounded-lg transition-all">
                        Explore Careers
                    </button>

                </div>


                <!-- Student Funding -->
                <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all">

                    <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center text-2xl mb-5">
                        🎓
                    </div>

                    <h2 class="text-lg font-bold mb-2">
                        Student Funding
                    </h2>

                    <p class="text-sm text-gray-500 mb-6">
                        Find information about bursaries, scholarships and funding opportunities.
                    </p>

                    <button class="w-full bg-red-500 hover:bg-red-600 text-white font-medium py-3 rounded-lg transition-all">
                        View Funding
                    </button>

                </div>


                <!-- General Help -->
                <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all">

                    <div class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center text-2xl mb-5">
                        🆘
                    </div>

                    <h2 class="text-lg font-bold mb-2">
                        General Help
                    </h2>

                    <p class="text-sm text-gray-500 mb-6">
                        Need help finding the right service? Start here.
                    </p>

                    <button class="w-full bg-gray-700 hover:bg-gray-800 text-white font-medium py-3 rounded-lg transition-all">
                        Get Help
                    </button>

                </div>

            </div>


            <!-- Help Notice -->
            <div class="mt-8 bg-blue-50 border border-blue-100 rounded-xl p-6">

                <div class="flex items-start gap-4">

                    <div class="text-2xl">
                        💡
                    </div>

                    <div>
                        <h2 class="font-bold text-blue-900">
                            Need help finding a service?
                        </h2>

                        <p class="text-sm text-blue-800 mt-1">
                            If you're unsure where to start, use General Help and we'll
                            direct you to the appropriate student service.
                        </p>
                    </div>

                </div>

            </div>

        </section>

    </main>

</body>
</html>