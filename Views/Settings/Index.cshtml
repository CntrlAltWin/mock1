@model mock1.Models.User

@{
    ViewData["Title"] = "Settings";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - Student Help Hub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(10px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .fade-in { animation: fadeInUp 0.4s ease-out forwards; }
        .input-field { transition: box-shadow 0.15s ease, border-color 0.15s ease; }
        .input-field:focus {
            outline: none;
            border-color: #1d4ed8;
            box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.15);
        }
        .input-field:disabled { background-color: #f9fafb; color: #9ca3af; }
    </style>
</head>

<body class="bg-gray-50">

    <aside class="fixed left-0 top-0 h-screen w-64 bg-white border-r border-gray-200">
        <div class="p-6 border-b border-gray-200">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-700 rounded-lg flex items-center justify-center text-white text-xl">🎓</div>
                <div>
                    <h1 class="font-bold text-gray-900">Student Help Hub</h1>
                    <p class="text-xs text-gray-500">Student Services</p>
                </div>
            </div>
        </div>

        <nav class="p-4 space-y-1">
            <a href="/Student/Dashboard" class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">🏠<span class="text-sm font-medium">Dashboard</span></a>
            <a href="/Timetable/Index" class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">📅<span class="text-sm font-medium">Timetable</span></a>
            <a href="/LostFound/Index" class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">🔎<span class="text-sm font-medium">Lost &amp; Found</span></a>
            <a href="/Assistance/Index" class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">🤝<span class="text-sm font-medium">Assistance</span></a>
            <a href="/Announcement/Index" class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">📢<span class="text-sm font-medium">Announcements</span></a>
            <a href="/Event/Index" class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">🎉<span class="text-sm font-medium">Events</span></a>
            <a href="/CampusMap/Index" class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">🗺️<span class="text-sm font-medium">Campus Map</span></a>
            <a href="/Profile/Index" class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">👤<span class="text-sm font-medium">My Profile</span></a>
        </nav>

        <div class="absolute bottom-0 left-0 right-0 p-4 border-t border-gray-200">
            <a href="/Settings/Index" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-blue-50 text-blue-700">⚙️<span class="text-sm font-semibold">Settings</span></a>
            <a asp-controller="Auth" asp-action="Logout" class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">🚪<span class="text-sm font-medium">Logout</span></a>
        </div>
    </aside>

    <main class="ml-64 min-h-screen">

        <header class="bg-white border-b border-gray-200 px-8 py-5">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-xl font-bold text-gray-900">Settings</h2>
                    <p class="text-sm text-gray-500 mt-1">Manage your account security</p>
                </div>
                <div class="flex items-center gap-5">
                    <a href="/Announcement/Index" class="relative text-gray-500 hover:text-blue-700 transition-colors">
                        <span class="text-xl">🔔</span>
                        <span class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 text-white text-[10px] rounded-full flex items-center justify-center">3</span>
                    </a>
                    <a href="/Profile/Index" class="w-10 h-10 rounded-full bg-blue-700 text-white flex items-center justify-center font-bold">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </a>
                </div>
            </div>
        </header>

        <div class="p-8 max-w-2xl">

            @if (TempData["Success"] != null)
            {
                <div class="bg-green-50 text-green-700 text-sm rounded-lg p-3 mb-6 fade-in">@TempData["Success"]</div>
            }
            @if (ViewBag.Error != null)
            {
                <div class="bg-red-50 text-red-600 text-sm rounded-lg p-3 mb-6 fade-in">@ViewBag.Error</div>
            }

            <h1 class="text-3xl font-bold text-gray-900 mb-6">Settings</h1>

            <!-- Account Info -->
            <div class="bg-white rounded-xl shadow-sm p-6 mb-6 fade-in">
                <h2 class="text-lg font-bold text-gray-900 mb-1">Account</h2>
                <p class="text-sm text-gray-500 mb-5">Your login details</p>

                <div>
                    <p class="text-sm text-gray-500">Email Address</p>
                    <p class="mt-1 font-medium text-gray-900">@Model.Email</p>
                </div>
            </div>

            <!-- Change Password -->
            <div class="bg-white rounded-xl shadow-sm p-6 fade-in">
                <h2 class="text-lg font-bold text-gray-900 mb-1">Change Password</h2>
                <p class="text-sm text-gray-500 mb-5">Update the password used to sign in</p>

                <form asp-controller="Settings" asp-action="ChangePassword" method="post" class="space-y-4">

                    <div>
                        <label class="text-sm font-medium text-gray-700">Current Password</label>
                        <input type="password" name="currentPassword" required
                               class="input-field w-full border border-gray-200 rounded-lg px-3 py-2 mt-1 text-sm" />
                    </div>

                    <div>
                        <label class="text-sm font-medium text-gray-700">New Password</label>
                        <input type="password" name="newPassword" minlength="8" required
                               class="input-field w-full border border-gray-200 rounded-lg px-3 py-2 mt-1 text-sm" />
                    </div>

                    <div>
                        <label class="text-sm font-medium text-gray-700">Confirm New Password</label>
                        <input type="password" name="confirmNewPassword" minlength="8" required
                               class="input-field w-full border border-gray-200 rounded-lg px-3 py-2 mt-1 text-sm" />
                    </div>

                    <button type="submit" class="bg-blue-700 text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-blue-800 transition-all">
                        Update Password
                    </button>
                </form>
            </div>

        </div>
    </main>
</body>
</html>
