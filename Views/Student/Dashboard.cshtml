@{
    ViewData["Title"] = "Student Dashboard";

    // Do not use the MVC shared layout for this page.
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Student Help Hub - Dashboard</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Inter font -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <!-- Dashboard styling -->
    <style>

            /* Use Inter throughout the dashboard */
            body {
                font-family: 'Inter', sans-serif;
            }

            /* Smooth scrolling */
            html {
                scroll-behavior: smooth;
            }

    </style>

</head>


<body class="bg-gray-50 text-gray-900">


    <!-- Main application container -->
    <div class="min-h-screen flex">


        <!-- ========================= -->
        <!-- SIDEBAR -->
        <!-- ========================= -->

        <aside class="w-64 bg-gray-100 border-r border-gray-200 flex flex-col fixed inset-y-0 left-0 z-20">


            <!-- Logo -->
            <div class="px-6 py-6 border-b border-gray-200">

                <div class="flex items-center gap-3">

                    <div class="w-10 h-10 rounded-xl bg-blue-700 text-white flex items-center justify-center font-bold">
                        SH
                    </div>

                    <div>

                        <h1 class="font-bold text-gray-900">
                            Student Help Hub
                        </h1>

                        <p class="text-xs text-gray-500">
                            Student Services
                        </p>

                    </div>

                </div>

            </div>


            <!-- Navigation -->
            <nav class="flex-1 px-4 py-6 space-y-1 overflow-y-auto">


                <!-- Dashboard -->
                <a href="#"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg bg-blue-50 text-blue-700 font-semibold">

                    <span class="w-6 text-center">
                        🏠
                    </span>

                    <span>
                        Dashboard
                    </span>

                </a>

                <!-- Timetable -->
                <a href="/Timetable/Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                    <span class="w-6 text-center">
                        📅
                    </span>

                    <span>
                        Timetable
                    </span>

                </a>


                <!-- Lost & Found -->
                <a href="/LostFound/Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                    <span class="w-6 text-center">
                        🔍
                    </span>

                    <span>
                        Lost & Found
                    </span>

                </a>


                <!-- Assistance -->
                <a href="/Assistance/Index" 
                   class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                    <span class="w-6 text-center">
                        🤝
                    </span>

                    <span>
                        Assistance
                    </span>

                </a>


                <!-- Announcements -->
                <a href="/Announcement/Index"
                   class="flex items-center justify-between px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                    <div class="flex items-center gap-3">

                        <span class="w-6 text-center">
                            📢
                        </span>

                        <span>
                            Announcements
                        </span>

                    </div>

                    <span class="text-xs font-bold bg-orange-100 text-orange-600 px-2 py-1 rounded-full">
                        3
                    </span>

                </a>


                <!-- Events -->
                <a href="/Event/Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">
                    <span class="w-6 text-center">
                        🎫
                    </span>

                    <span>
                        Events
                    </span>

                </a>


                <!-- Campus Map -->
                <a href="/Event/Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">
                    🎉
                    <span class="text-sm font-medium">Events</span>
                </a>

                <a href="/CampusMap/Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">
                    🗺️
                    <span class="text-sm font-medium">Campus Map</span>
                </a>

                <a href="#"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">
                    👤
                    <span class="text-sm font-medium">My Profile</span>
                </a>


                <!-- Profile -->
                <a href="/Profile/Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">

                    👤

                    <span class="text-sm font-medium">
                        My Profile
                    </span>

                </a>

            </nav>


            <!-- Bottom navigation -->
            <div class="px-4 py-5 border-t border-gray-200 space-y-1">


                <!-- Settings -->
                <a href="#"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                    <span class="w-6 text-center">
                        ⚙️
                    </span>

                    <span>
                        Settings
                    </span>

                </a>


                <!-- Logout -->
                <a href="#"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-red-600 transition-all">

                    <span class="w-6 text-center">
                        ↪
                    </span>

                    <span>
                        Logout
                    </span>

                </a>

            </div>

        </aside>



        <!-- ========================= -->
        <!-- MAIN CONTENT -->
        <!-- ========================= -->

        <main class="ml-64 flex-1 min-w-0">


            <!-- ========================= -->
            <!-- TOP BAR -->
            <!-- ========================= -->

            <header class="bg-white border-b border-gray-200">

                <div class="px-8 py-5 flex items-center justify-between">


                    <!-- Greeting -->
                    <div>

                        <h2 class="text-xl font-bold text-gray-900">
                            Welcome back, Student 👋
                        </h2>

                        <p class="text-sm text-gray-500 mt-1">
                            Here's what's happening today.
                        </p>

                    </div>


                    <!-- Right side -->
                    <div class="flex items-center gap-5">


                        <!-- Notification -->
                        <button class="relative text-gray-500 hover:text-blue-700 transition-colors">

                            <span class="text-xl">
                                🔔
                            </span>

                            <!-- Notification badge -->
                            <span class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 text-white text-[10px] rounded-full flex items-center justify-center">
                                3
                            </span>

                        </button>


                        <!-- User profile -->
                        <div class="flex items-center gap-3">

                            <div class="w-10 h-10 rounded-full bg-blue-700 text-white flex items-center justify-center font-bold">
                                S
                            </div>

                            <div class="hidden sm:block">

                                <p class="text-sm font-semibold text-gray-900">
                                    Student
                                </p>

                                <p class="text-xs text-gray-500">
                                    Student
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </header>



            <!-- ========================= -->
            <!-- DASHBOARD CONTENT -->
            <!-- ========================= -->

            <div class="px-8 py-8">


                <!-- Keep content from becoming excessively wide -->
                <div class="max-w-7xl mx-auto">


                    <!-- ========================= -->
                    <!-- HERO -->
                    <!-- ========================= -->

                    <section class="relative overflow-hidden rounded-xl bg-gradient-to-r from-blue-700 to-blue-500 p-8 mb-8">


                        <!-- Hero text -->
                        <div class="relative z-10 max-w-2xl">

                            <p class="text-blue-100 text-sm font-medium mb-2">
                                Student Dashboard
                            </p>

                            <h1 class="text-3xl md:text-4xl font-bold text-white">
                                Good morning, Student!
                            </h1>

                            <p class="mt-3 text-blue-100">
                                Everything you need for student life in one place.
                            </p>

                        </div>


                        <!-- Academic cap -->
                        <div class="absolute right-8 top-1/2 -translate-y-1/2 text-8xl opacity-20">
                            🎓
                        </div>

                    </section>



                    <!-- ========================= -->
                    <!-- SUMMARY METRICS -->
                    <!-- ========================= -->

                    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">


                        <!-- Today's classes -->
                        <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all">

                            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-700 flex items-center justify-center">
                                📚
                            </div>

                            <p class="mt-5 text-sm text-gray-500">
                                Today's Classes
                            </p>

                            <p class="mt-1 text-3xl font-bold text-gray-900">
                                3
                            </p>

                        </div>


                        <!-- Upcoming tests -->
                        <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all">

                            <div class="w-10 h-10 rounded-lg bg-orange-50 text-orange-600 flex items-center justify-center">
                                📝
                            </div>

                            <p class="mt-5 text-sm text-gray-500">
                                Upcoming Tests
                            </p>

                            <p class="mt-1 text-3xl font-bold text-gray-900">
                                2
                            </p>

                        </div>


                        <!-- Announcements -->
                        <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all">

                            <div class="w-10 h-10 rounded-lg bg-red-50 text-red-500 flex items-center justify-center">
                                📢
                            </div>

                            <p class="mt-5 text-sm text-gray-500">
                                Announcements
                            </p>

                            <p class="mt-1 text-3xl font-bold text-gray-900">
                                3
                            </p>

                        </div>


                        <!-- Upcoming events -->
                        <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all">

                            <div class="w-10 h-10 rounded-lg bg-green-50 text-green-600 flex items-center justify-center">
                                🎫
                            </div>

                            <p class="mt-5 text-sm text-gray-500">
                                Upcoming Events
                            </p>

                            <p class="mt-1 text-3xl font-bold text-gray-900">
                                4
                            </p>

                        </div>

                    </section>



                    <!-- ========================= -->
                    <!-- MAIN GRID -->
                    <!-- ========================= -->

                    <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">


                        <!-- ========================= -->
                        <!-- TODAY'S SCHEDULE -->
                        <!-- ========================= -->

                        <div class="lg:col-span-2 bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all">


                            <!-- Heading -->
                            <div class="flex items-center justify-between mb-6">

                                <div>

                                    <h2 class="text-lg font-bold text-gray-900">
                                        Today's Schedule
                                    </h2>

                                    <p class="text-sm text-gray-500 mt-1">
                                        Your classes for today
                                    </p>

                                </div>

                                <a href="#"
                                   class="text-sm font-semibold text-blue-700 hover:text-blue-900">

                                    View timetable →

                                </a>

                            </div>



                            <!-- Schedule entries -->
                            <div class="space-y-3">


                                <!-- Schedule entry 1 -->
                                <div class="flex items-center gap-5 p-4 rounded-lg bg-gray-50 hover:bg-blue-50 transition-all">


                                    <!-- Time -->
                                    <div class="w-20 shrink-0">

                                        <p class="text-sm font-bold text-blue-700">
                                            08:00
                                        </p>

                                        <p class="text-xs text-gray-500 mt-1">
                                            10:00
                                        </p>

                                    </div>


                                    <!-- Divider -->
                                    <div class="w-px h-12 bg-gray-200">
                                    </div>


                                    <!-- Course information -->
                                    <div class="flex-1 min-w-0">

                                        <p class="font-bold text-gray-900">
                                            GID226C
                                        </p>

                                        <p class="text-sm text-gray-500 truncate">
                                            Graphic User Interface Design
                                        </p>

                                        <p class="text-xs text-gray-400 mt-1">
                                            Room 201
                                        </p>

                                    </div>

                                </div>



                                <!-- Schedule entry 2 -->
                                <div class="flex items-center gap-5 p-4 rounded-lg bg-gray-50 hover:bg-blue-50 transition-all">


                                    <!-- Time -->
                                    <div class="w-20 shrink-0">

                                        <p class="text-sm font-bold text-blue-700">
                                            10:15
                                        </p>

                                        <p class="text-xs text-gray-500 mt-1">
                                            12:15
                                        </p>

                                    </div>


                                    <!-- Divider -->
                                    <div class="w-px h-12 bg-gray-200">
                                    </div>


                                    <!-- Course information -->
                                    <div class="flex-1 min-w-0">

                                        <p class="font-bold text-gray-900">
                                            SOE226C
                                        </p>

                                        <p class="text-sm text-gray-500 truncate">
                                            Systems and Software Engineering
                                        </p>

                                        <p class="text-xs text-gray-400 mt-1">
                                            Lab 3
                                        </p>

                                    </div>

                                </div>



                                <!-- Schedule entry 3 -->
                                <div class="flex items-center gap-5 p-4 rounded-lg bg-gray-50 hover:bg-blue-50 transition-all">


                                    <!-- Time -->
                                    <div class="w-20 shrink-0">

                                        <p class="text-sm font-bold text-blue-700">
                                            13:00
                                        </p>

                                        <p class="text-xs text-gray-500 mt-1">
                                            15:00
                                        </p>

                                    </div>


                                    <!-- Divider -->
                                    <div class="w-px h-12 bg-gray-200">
                                    </div>


                                    <!-- Course information -->
                                    <div class="flex-1 min-w-0">

                                        <p class="font-bold text-gray-900">
                                            SOD226C
                                        </p>

                                        <p class="text-sm text-gray-500 truncate">
                                            Systems and Operations Development
                                        </p>

                                        <p class="text-xs text-gray-400 mt-1">
                                            Room 108
                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>



                        <!-- ========================= -->
                        <!-- QUICK ACTIONS -->
                        <!-- ========================= -->

                        <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all">


                            <!-- Heading -->
                            <div class="mb-6">

                                <h2 class="text-lg font-bold text-gray-900">
                                    Quick Actions
                                </h2>

                                <p class="text-sm text-gray-500 mt-1">
                                    Common student services
                                </p>

                            </div>


                            <!-- 2x2 action grid -->
                            <div class="grid grid-cols-2 gap-3">


                                <!-- Report lost -->
                                <a href="#"
                                   class="p-4 rounded-lg border border-gray-200 text-center hover:bg-blue-50 hover:border-blue-200 transition-all">

                                    <div class="w-10 h-10 mx-auto rounded-lg bg-blue-50 flex items-center justify-center text-blue-700">
                                        🔎
                                    </div>

                                    <p class="mt-3 text-sm font-bold text-gray-900">
                                        Report Lost
                                    </p>

                                    <p class="mt-1 text-xs text-gray-500">
                                        Lost item
                                    </p>

                                </a>


                                <!-- Report found -->
                                <a href="#"
                                   class="p-4 rounded-lg border border-gray-200 text-center hover:bg-green-50 hover:border-green-200 transition-all">

                                    <div class="w-10 h-10 mx-auto rounded-lg bg-green-50 flex items-center justify-center text-green-600">
                                        📦
                                    </div>

                                    <p class="mt-3 text-sm font-bold text-gray-900">
                                        Report Found
                                    </p>

                                    <p class="mt-1 text-xs text-gray-500">
                                        Found item
                                    </p>

                                </a>


                                <!-- Get assistance -->
                                <a href="/Assistance/Index"
                                   class="block bg-white rounded-xl p-6 hover:shadow-md transition-all cursor-pointer">

                                    <div class="w-10 h-10 mx-auto rounded-lg bg-orange-50 flex items-center justify-center text-orange-600">
                                        🤝
                                    </div>

                                    <p class="mt-3 text-sm font-bold text-gray-900 text-center">
                                        Assistance
                                    </p>

                                    <p class="mt-1 text-xs text-gray-500 text-center">
                                        Get support
                                    </p>

                                </a>


                                <!-- Campus map -->
                                <a href="#"
                                   class="p-4 rounded-lg border border-gray-200 text-center hover:bg-red-50 hover:border-red-200 transition-all">

                                    <div class="w-10 h-10 mx-auto rounded-lg bg-red-50 flex items-center justify-center text-red-500">
                                        🗺️
                                    </div>

                                    <p class="mt-3 text-sm font-bold text-gray-900">
                                        Campus Map
                                    </p>

                                    <p class="mt-1 text-xs text-gray-500">
                                        Find locations
                                    </p>

                                </a>

                            </div>

                        </div>

                    </section>

                </div>

            </div>

        </main>

    </div>


</body>

</html>