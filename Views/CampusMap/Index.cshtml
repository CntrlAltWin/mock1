@{
    ViewData["Title"] = "Campus Map";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Campus Map - Student Help Hub</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>
            body {
                font-family: 'Inter', sans-serif;
            }
    </style>
</head>

<body class="bg-gray-50">

    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 h-screen w-64 bg-white border-r border-gray-200">

        <!-- Logo -->
        <div class="p-6 border-b border-gray-200">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-700 rounded-lg flex items-center justify-center text-white text-xl">
                    🎓
                </div>

                <div>
                    <h1 class="font-bold text-gray-900">Student Help Hub</h1>
                    <p class="text-xs text-gray-500">Student Services</p>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <nav class="p-4 space-y-1">

            <a href="/Student/Dashboard"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">
                🏠
                <span class="text-sm font-medium">Dashboard</span>
            </a>

            <a href="/Timetable/Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">
                📅
                <span class="text-sm font-medium">Timetable</span>
            </a>

            <a href="/LostFound/Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">
                🔎
                <span class="text-sm font-medium">Lost & Found</span>
            </a>

            <a href="/Assistance/Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">
                🤝
                <span class="text-sm font-medium">Assistance</span>
            </a>

            <a href="/Announcement/Index"
               class="flex items-center justify-between px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">

                <div class="flex items-center gap-3">
                    📢
                    <span class="text-sm font-medium">Announcements</span>
                </div>

                <span class="text-xs bg-red-500 text-white px-2 py-1 rounded-full">
                    3
                </span>
            </a>

            <a href="/Event/Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">
                🎉
                <span class="text-sm font-medium">Events</span>
            </a>

            <!-- Active Campus Map -->
            <a href="/CampusMap/Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg bg-blue-50 text-blue-700">

                🗺️

                <span class="text-sm font-semibold">
                    Campus Map
                </span>
            </a>

            <a href="#"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">
                👤
                <span class="text-sm font-medium">My Profile</span>
            </a>

        </nav>

        <!-- Bottom Navigation -->
        <div class="absolute bottom-0 left-0 right-0 p-4 border-t border-gray-200">

            <a href="#"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">
                ⚙️
                <span class="text-sm font-medium">Settings</span>
            </a>

            <a href="#"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-gray-100">
                🚪
                <span class="text-sm font-medium">Logout</span>
            </a>

        </div>

    </aside>


    <!-- Main Content -->
    <main class="ml-64 min-h-screen">

        <!-- Top Bar -->
        <header class="bg-white border-b border-gray-200 px-8 py-5">

            <div class="flex items-center justify-between">

                <div>
                    <h2 class="text-xl font-bold text-gray-900">
                        Welcome back, Student 👋
                    </h2>

                    <p class="text-sm text-gray-500 mt-1">
                        Find your way around campus
                    </p>
                </div>

                <div class="flex items-center gap-5">

                    <button class="text-gray-500 hover:text-gray-700 text-xl">
                        🔔
                    </button>

                    <div class="w-10 h-10 rounded-full bg-blue-700 text-white flex items-center justify-center font-bold">
                        S
                    </div>

                </div>

            </div>

        </header>


        <!-- Page Content -->
        <div class="p-8">

            <!-- Page Heading -->
            <div class="mb-6">

                <h1 class="text-3xl font-bold text-gray-900">
                    Campus Map
                </h1>

                <p class="text-gray-500 mt-1">
                    Find important locations around campus
                </p>

            </div>


            <!-- Map Area -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">

                <!-- Map Header -->
                <div class="p-6 border-b border-gray-200">

                    <div class="flex items-center justify-between">

                        <div>
                            <h2 class="text-lg font-bold text-gray-900">
                                Campus Locations
                            </h2>

                            <p class="text-sm text-gray-500 mt-1">
                                Select a location to view more information
                            </p>
                        </div>

                        <div class="text-3xl">
                            🗺️
                        </div>

                    </div>

                </div>


                <!-- Simple Map -->
                <div class="relative bg-blue-50 h-[500px] p-8">

                    <!-- Roads -->
                    <div class="absolute left-0 right-0 top-1/2 h-16 bg-gray-200"></div>

                    <div class="absolute top-0 bottom-0 left-1/2 w-16 bg-gray-200"></div>


                    <!-- Main Campus -->
                    <div class="absolute top-10 left-10 bg-white rounded-xl shadow-md p-5 w-48">

                        <div class="text-2xl mb-2">
                            🏫
                        </div>

                        <h3 class="font-bold text-gray-900">
                            Main Campus
                        </h3>

                        <p class="text-xs text-gray-500 mt-1">
                            Main academic buildings
                        </p>

                    </div>


                    <!-- Library -->
                    <div class="absolute top-10 right-10 bg-white rounded-xl shadow-md p-5 w-48">

                        <div class="text-2xl mb-2">
                            📚
                        </div>

                        <h3 class="font-bold text-gray-900">
                            Library
                        </h3>

                        <p class="text-xs text-gray-500 mt-1">
                            Study and research facilities
                        </p>

                    </div>


                    <!-- Student Centre -->
                    <div class="absolute bottom-10 left-10 bg-white rounded-xl shadow-md p-5 w-48">

                        <div class="text-2xl mb-2">
                            🧑‍🎓
                        </div>

                        <h3 class="font-bold text-gray-900">
                            Student Centre
                        </h3>

                        <p class="text-xs text-gray-500 mt-1">
                            Student services and activities
                        </p>

                    </div>


                    <!-- Sports Centre -->
                    <div class="absolute bottom-10 right-10 bg-white rounded-xl shadow-md p-5 w-48">

                        <div class="text-2xl mb-2">
                            🏟️
                        </div>

                        <h3 class="font-bold text-gray-900">
                            Sports Centre
                        </h3>

                        <p class="text-xs text-gray-500 mt-1">
                            Sports and recreation
                        </p>

                    </div>


                    <!-- You Are Here -->
                    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2">

                        <div class="w-14 h-14 bg-blue-700 rounded-full border-4 border-white shadow-lg flex items-center justify-center text-white text-xl">
                            📍
                        </div>

                    </div>

                </div>

            </div>


            <!-- Location List -->
            <div class="mt-6">

                <h2 class="text-lg font-bold text-gray-900 mb-4">
                    Important Locations
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">


                    <!-- Location -->
                    <div class="bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-all">

                        <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center text-xl">
                            🏫
                        </div>

                        <h3 class="mt-3 font-bold text-gray-900">
                            Main Campus
                        </h3>

                        <p class="text-sm text-gray-500 mt-1">
                            Academic buildings
                        </p>

                    </div>


                    <!-- Location -->
                    <div class="bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-all">

                        <div class="w-10 h-10 rounded-lg bg-purple-50 flex items-center justify-center text-xl">
                            📚
                        </div>

                        <h3 class="mt-3 font-bold text-gray-900">
                            Library
                        </h3>

                        <p class="text-sm text-gray-500 mt-1">
                            Study and research
                        </p>

                    </div>


                    <!-- Location -->
                    <div class="bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-all">

                        <div class="w-10 h-10 rounded-lg bg-green-50 flex items-center justify-center text-xl">
                            🧑‍🎓
                        </div>

                        <h3 class="mt-3 font-bold text-gray-900">
                            Student Centre
                        </h3>

                        <p class="text-sm text-gray-500 mt-1">
                            Student services
                        </p>

                    </div>


                    <!-- Location -->
                    <div class="bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-all">

                        <div class="w-10 h-10 rounded-lg bg-orange-50 flex items-center justify-center text-xl">
                            🏟️
                        </div>

                        <h3 class="mt-3 font-bold text-gray-900">
                            Sports Centre
                        </h3>

                        <p class="text-sm text-gray-500 mt-1">
                            Sports and recreation
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </main>

</body>
</html>