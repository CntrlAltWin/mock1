@{
    ViewData["Title"] = "Lost & Found";

    // Do not use the MVC shared layout for this page.
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Lost & Found - Student Help Hub</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Inter font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
            body {
                font-family: 'Inter', sans-serif;
            }
    </style>
</head>

<body class="bg-gray-50 text-gray-900">

    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 h-screen w-64 bg-gray-100 border-r border-gray-200">

        <!-- Logo -->
        <div class="px-6 py-6 border-b border-gray-200">
            <h1 class="text-xl font-bold text-blue-700">
                Student Help Hub
            </h1>

            <p class="text-sm text-gray-500 mt-1">
                Student Services
            </p>
        </div>

        <!-- Navigation -->
        <nav class="p-4 space-y-2">

            <!-- Dashboard -->
            <a href="/Student/Dashboard"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                <span class="w-6 text-center">🏠</span>
                <span>Dashboard</span>

            </a>

            <!-- Timetable -->
            <a href="/Timetable/Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                <span class="w-6 text-center">📅</span>
                <span>Timetable</span>

            </a>

            <!-- Lost & Found -->
            <a href="/LostFound/Index"
               class="flex items-center gap-3 px-4 py-3 rounded-lg bg-blue-700 text-white">

                <span class="w-6 text-center">🔍</span>
                <span>Lost & Found</span>

            </a>

            <!-- Assistance -->
            <a href="#"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                <span class="w-6 text-center">🤝</span>
                <span>Assistance</span>

            </a>

            <!-- Announcements -->
            <a href="#"
               class="flex items-center justify-between px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                <div class="flex items-center gap-3">
                    <span class="w-6 text-center">📢</span>
                    <span>Announcements</span>
                </div>

                <span class="bg-red-500 text-white text-xs px-2 py-1 rounded-full">
                    3
                </span>

            </a>

            <!-- Events -->
            <a href="#"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                <span class="w-6 text-center">🎉</span>
                <span>Events</span>

            </a>

            <!-- Campus Map -->
            <a href="#"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                <span class="w-6 text-center">🗺️</span>
                <span>Campus Map</span>

            </a>

            <!-- My Profile -->
            <a href="#"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                <span class="w-6 text-center">👤</span>
                <span>My Profile</span>

            </a>

        </nav>

        <!-- Bottom Navigation -->
        <div class="absolute bottom-0 left-0 right-0 p-4 border-t border-gray-200">

            <a href="#"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-blue-700 transition-all">

                <span class="w-6 text-center">⚙️</span>
                <span>Settings</span>

            </a>

            <a href="#"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-600 hover:bg-white hover:text-red-600 transition-all">

                <span class="w-6 text-center">🚪</span>
                <span>Logout</span>

            </a>

        </div>

    </aside>


    <!-- Main Content -->
    <main class="ml-64 min-h-screen">

        <!-- Top Bar -->
        <header class="bg-white border-b border-gray-200 px-8 py-5 flex items-center justify-between">

            <div>
                <h2 class="text-xl font-bold text-gray-900">
                    Welcome back, Student 👋
                </h2>

                <p class="text-sm text-gray-500">
                    Find or report lost items around campus.
                </p>
            </div>

            <div class="flex items-center gap-4">

                <button class="relative text-gray-500 text-xl">
                    🔔

                    <span class="absolute -top-1 -right-1 w-2 h-2 bg-red-500 rounded-full"></span>
                </button>

                <div class="w-10 h-10 rounded-full bg-blue-700 text-white flex items-center justify-center font-bold">
                    S
                </div>

            </div>

        </header>


        <!-- Page Content -->
        <section class="p-8">

            <!-- Page Heading -->
            <div class="mb-8">
                <h1 class="text-3xl font-bold text-gray-900">
                    Lost & Found
                </h1>

                <p class="text-gray-500 mt-2">
                    Report lost items or check if someone has found your belongings.
                </p>
            </div>


            <!-- Action Buttons -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">

                <!-- Report Lost -->
                <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all">

                    <div class="flex items-center gap-4 mb-4">

                        <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center text-2xl">
                            🔴
                        </div>

                        <div>
                            <h2 class="text-lg font-bold">
                                Lost Something?
                            </h2>

                            <p class="text-sm text-gray-500">
                                Report an item you have lost.
                            </p>
                        </div>

                    </div>

                    <button class="w-full bg-red-500 hover:bg-red-600 text-white font-medium py-3 rounded-lg transition-all">
                        Report Lost Item
                    </button>

                </div>


                <!-- Report Found -->
                <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all">

                    <div class="flex items-center gap-4 mb-4">

                        <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center text-2xl">
                            🟢
                        </div>

                        <div>
                            <h2 class="text-lg font-bold">
                                Found Something?
                            </h2>

                            <p class="text-sm text-gray-500">
                                Report an item you found on campus.
                            </p>
                        </div>

                    </div>

                    <button class="w-full bg-green-600 hover:bg-green-700 text-white font-medium py-3 rounded-lg transition-all">
                        Report Found Item
                    </button>

                </div>

            </div>


            <!-- Recent Lost & Found Items -->
            <div class="bg-white rounded-xl shadow-sm">

                <div class="p-6 border-b border-gray-200">

                    <div class="flex items-center justify-between">

                        <div>
                            <h2 class="text-xl font-bold">
                                Recent Items
                            </h2>

                            <p class="text-sm text-gray-500 mt-1">
                                Recently reported lost and found items.
                            </p>
                        </div>

                        <button class="text-blue-700 font-medium hover:underline">
                            View All
                        </button>

                    </div>

                </div>


                <!-- Item 1 -->
                <div class="p-6 border-b border-gray-100 flex items-center justify-between">

                    <div class="flex items-center gap-4">

                        <div class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center text-2xl">
                            💳
                        </div>

                        <div>
                            <h3 class="font-semibold">
                                Student Card
                            </h3>

                            <p class="text-sm text-gray-500">
                                Lost near Main Campus
                            </p>

                            <p class="text-xs text-gray-400 mt-1">
                                Reported 2 hours ago
                            </p>
                        </div>

                    </div>

                    <span class="px-3 py-1 bg-red-100 text-red-600 text-sm rounded-full">
                        Lost
                    </span>

                </div>


                <!-- Item 2 -->
                <div class="p-6 border-b border-gray-100 flex items-center justify-between">

                    <div class="flex items-center gap-4">

                        <div class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center text-2xl">
                            🎧
                        </div>

                        <div>
                            <h3 class="font-semibold">
                                Wireless Earphones
                            </h3>

                            <p class="text-sm text-gray-500">
                                Found in Library
                            </p>

                            <p class="text-xs text-gray-400 mt-1">
                                Reported yesterday
                            </p>
                        </div>

                    </div>

                    <span class="px-3 py-1 bg-green-100 text-green-600 text-sm rounded-full">
                        Found
                    </span>

                </div>


                <!-- Item 3 -->
                <div class="p-6 flex items-center justify-between">

                    <div class="flex items-center gap-4">

                        <div class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center text-2xl">
                            🎒
                        </div>

                        <div>
                            <h3 class="font-semibold">
                                Black Backpack
                            </h3>

                            <p class="text-sm text-gray-500">
                                Lost near Student Centre
                            </p>

                            <p class="text-xs text-gray-400 mt-1">
                                Reported 2 days ago
                            </p>
                        </div>

                    </div>

                    <span class="px-3 py-1 bg-red-100 text-red-600 text-sm rounded-full">
                        Lost
                    </span>

                </div>

            </div>

        </section>

    </main>

</body>
</html>